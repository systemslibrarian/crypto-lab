cff-version: 1.2.0
message: "If you use Crypto Lab in teaching or research, please cite it as below."
type: software
title: "Crypto Lab: Interactive Browser-Based Cryptography Demonstrations"
abstract: "A free, open-source collection of more than 200 interactive browser-based cryptography demonstrations covering classical and modern cryptography, cryptanalysis, privacy technologies, and post-quantum cryptography, with course modules for instructors."
authors:
  - family-names: "Clark"
    given-names: "Paul A."
    affiliation: "Leon County Public Library"
    orcid: "https://orcid.org/0009-0004-2394-0991"
# Matches the GitHub release tag Zenodo archives (v1.0.0 -> "1.0.0"). Bump version
# and date-released together when cutting a release; nothing in tools/ does it.
version: "1.0.0"
date-released: "2026-10-02"
url: "https://crypto-lab.systemslibrarian.dev/"
repository-code: "https://github.com/systemslibrarian/crypto-lab"
# Concept DOI ("cite all versions"); resolves to the latest Zenodo release.
doi: 10.5281/zenodo.23105362
# The software repository is MIT licensed. Teaching materials under teach/
# remain CC BY 4.0 under teach/LICENSE.
license: MIT
keywords:
  - cryptography
  - cryptography education
  - post-quantum cryptography
  - cryptanalysis
